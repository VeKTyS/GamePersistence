<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same target as the base plugin -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RaidRecovery.Fika.Client</RootNamespace>
    <AssemblyName>RaidRecovery.Fika.Client</AssemblyName>
    <Version>$(FikaAddonVersion)</Version>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>bin\$(Configuration)\RaidRecoveryFika\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- References are resolved through their HintPath only: no same-named copy picked up elsewhere -->
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
  </PropertyGroup>

  <!-- The base plugin is installed on its own: its DLL is not copied next to the add-on -->
  <ItemGroup>
    <ProjectReference Include="..\RaidRecovery.Client\RaidRecovery.Client.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Everything is provided by the game at load time: nothing is copied next to the plugin -->
  <ItemGroup>
    <Reference Include="Fika.Core">
      <HintPath>$(SptBepInExPath)\plugins\Fika\Fika.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptBepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptBepInExPath)\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptManagedPath)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The raid of Fika implements an interface of this library -->
    <Reference Include="DissonanceVoip">
      <HintPath>$(SptManagedPath)\DissonanceVoip.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The "join" function of Fika takes the button that was clicked -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SptManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The end-of-raid screen of the game is built on a type of this library -->
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptManagedPath)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
