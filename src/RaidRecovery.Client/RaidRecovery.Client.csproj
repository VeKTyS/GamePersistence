<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Same target as the SPT 4.1 client modules (spt-singleplayer, spt-custom) -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RaidRecovery.Client</RootNamespace>
    <AssemblyName>RaidRecovery.Client</AssemblyName>
    <Version>$(ModVersion)</Version>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputPath>bin\$(Configuration)\RaidRecovery\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- References are resolved through their HintPath only: no same-named copy picked up elsewhere -->
    <AssemblySearchPaths>{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
  </PropertyGroup>

  <!-- Everything is provided by the game at load time: nothing is copied next to the plugin -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInExPath)\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptBepInExPath)\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptBepInExPath)\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptBepInExPath)\plugins\spt\spt-reflection.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptManagedPath)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SptManagedPath)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The game's screens (MenuScreen) inherit from a type of this library -->
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptManagedPath)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Recovery window -->
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SptManagedPath)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
